# Copy to .env.local. Local file is ignored by Git. Never send keys in chat.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# Optional alternative: LLM_PROVIDER=qwen, LLM_MODEL=qwen-plus
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Required for public/production live Agent. Use the REST token, not a read-only token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SESSION_QUESTION_LIMIT=10
DAILY_QUESTION_LIMIT=100
MODEL_TIMEOUT_SECONDS=22
AGENT_TIMEOUT_SECONDS=78
APP_MODE=local
